  "name": "mantine-next-fumadocs-template",
  "packageManager": "yarn@4.18.0",
  "private": true,
  "scripts": {
    "analyze": "ANALYZE=true next build",
    "build": "next build",
    "build:static": "node scripts/static-export-prepare.mjs && NEXT_PUBLIC_STATIC_EXPORT=1 next build",
    "dev": "next dev",
    "oxlint": "oxlint .",
    "jest": "jest",
    "jest:watch": "jest --watch",
    "lint": "npm run oxlint && npm run stylelint",
    "format:test": "oxfmt --check \"**/*.{ts,tsx,css}\"",
    "format:write": "oxfmt --write \"**/*.{ts,tsx,css}\"",
    "postinstall": "fumadocs-mdx",
    "release:major": "yarn version major",
    "release:minor": "yarn version minor",
    "release:patch": "yarn version patch",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "stylelint": "stylelint '**/*.css' --cache",
    "test": "npx fumadocs-mdx && npx next typegen && npm run format:test && npm run lint && npm run typecheck && npm run jest",
    "typecheck": "tsc --noEmit"
  },
  "version": "1.0.5",
  "resolutions": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.0",
    "tar": "^7.5.19"
